# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash
# Optional tuning (see lirr_agent/llm.py and lirr_agent/agents/lead.py)
# RESEARCHER_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# MAX_RESEARCH_ROUNDS=2
# MAX_PARALLEL_RESEARCHERS=4
# Cloud Run only: where to download the database from at startup
# LIRR_DB_GCS_URI=gs://your-bucket/lirr.duckdb
# Use Gemini through Vertex AI instead of an API key (what Cloud Run does)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
